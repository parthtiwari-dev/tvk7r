{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/app.py": {
      "includeFiles": "api/data/**"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/app" }]
}
